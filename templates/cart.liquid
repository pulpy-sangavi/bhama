<section class="bhama-section">
  <div class="bhama-container">
    <div class="bhama-heading">
      <div>
        <p class="bhama-eyebrow">Shopping Bag</p>
        <h2>Your cart</h2>
      </div>
    </div>

    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div class="bhama-product-info">
          {% for item in cart.items %}
            <div style="display:grid;grid-template-columns:90px 1fr auto;gap:16px;align-items:center;padding:14px 0;border-bottom:1px solid var(--bhama-line);">
              {% if item.image %}
                {{ item.image | image_url: width: 180 | image_tag: loading: 'lazy', alt: item.product.title, width: 90, height: 120 }}
              {% endif %}
              <div>
                <strong>{{ item.product.title }}</strong>
                <p style="margin:4px 0;color:var(--bhama-muted);">{{ item.variant.title }}</p>
                <input class="bhama-quantity" style="max-width:100px;" type="number" name="updates[]" value="{{ item.quantity }}" min="0">
              </div>
              <strong>{{ item.final_line_price | money }}</strong>
            </div>
          {% endfor %}
          <div style="display:flex;justify-content:space-between;align-items:center;margin-top:22px;">
            <strong>Subtotal</strong>
            <strong class="bhama-product-price">{{ cart.total_price | money }}</strong>
          </div>
          <div class="bhama-btn-row" style="margin-top:18px;">
            <button class="bhama-btn bhama-btn-outline" type="submit" name="update">Update cart</button>
            <button class="bhama-btn" type="submit" name="checkout">Checkout</button>
          </div>
        </div>
      </form>
    {% else %}
      <div class="bhama-product-info">
        <p>Your cart is empty.</p>
        <a class="bhama-btn" href="{{ routes.collections_url }}">Continue shopping</a>
      </div>
    {% endif %}
  </div>
</section>
