<section class="bhama-page-hero">
  <div class="bhama-container">
    <p class="bhama-eyebrow">Shopping Bag</p>
    <h1>Your cart</h1>
    <p>{{ cart.item_count }} item{% unless cart.item_count == 1 %}s{% endunless %} selected for checkout.</p>
  </div>
</section>

<section class="bhama-section" style="padding-top:0;">
  <div class="bhama-container">
    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div class="bhama-cart-panel">
          {% for item in cart.items %}
            <div class="bhama-cart-row">
              {% if item.image %}
                {{ item.image | image_url: width: 220 | image_tag: loading: 'lazy', alt: item.product.title, width: 96, height: 128 }}
              {% endif %}
              <div>
                <strong>{{ item.product.title }}</strong>
                {% unless item.variant.title == 'Default Title' %}
                  <p>{{ item.variant.title }}</p>
                {% endunless %}
                <input class="bhama-input" style="max-width:110px;" type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity for {{ item.product.title | escape }}">
              </div>
              <strong>{{ item.final_line_price | money }}</strong>
            </div>
          {% endfor %}

          <div class="bhama-cart-summary">
            <div>
              <p class="bhama-eyebrow">Subtotal</p>
              <strong class="bhama-product-price">{{ cart.total_price | money }}</strong>
            </div>
            <div class="bhama-btn-row">
              <button class="bhama-btn bhama-btn-outline" type="submit" name="update">Update cart</button>
              <button class="bhama-btn" type="submit" name="checkout">Checkout</button>
            </div>
          </div>
        </div>
      </form>
    {% else %}
      <div class="bhama-empty-state">
        <h2>Your bag is empty</h2>
        <p>Browse the latest BHAMA pieces and add your favourites.</p>
        <a class="bhama-btn" href="{{ routes.collections_url }}">Continue shopping</a>
      </div>
    {% endif %}
  </div>
</section>
