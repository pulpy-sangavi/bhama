{%- assign current_variant = product.selected_or_first_available_variant -%}

<nav class="product-breadcrumb" aria-label="Breadcrumb">
  <div class="container-fluid">
    <a href="{{ routes.root_url }}">Home</a>
    <span>/</span>
    <a href="{{ routes.all_products_collection_url }}">Shop</a>
    {%- if product.collections.first -%}
      <span>/</span>
      <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
    {%- endif -%}
    <span>/</span>
    <span>{{ product.title }}</span>
  </div>
</nav>

<section class="section section-ivory">
  <div class="container-fluid product-page" data-bhama-product data-money-format="{{ shop.money_format | escape }}">
    <script type="application/json" data-bhama-product-json>
      {{ product | json }}
    </script>

    <div class="gallery">
      <div class="thumbs">
        {%- assign gallery_index = 0 -%}
        {%- for media in product.media limit: 6 -%}
          {%- if media.media_type == 'image' -%}
            <button class="thumb-button{% if gallery_index == 0 %} is-active{% endif %}" type="button" data-bhama-thumbnail="{{ gallery_index }}" aria-label="View product image {{ gallery_index | plus: 1 }}" aria-pressed="{% if gallery_index == 0 %}true{% else %}false{% endif %}">
              {{ media.preview_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: media.alt | default: product.title }}
            </button>
            {%- assign gallery_index = gallery_index | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="main-product-wrap">
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="main-product-badge">Sale</span>
        {%- elsif product.tags contains 'New' -%}
          <span class="main-product-badge">New</span>
        {%- endif -%}
        {%- assign gallery_index = 0 -%}
        {%- for media in product.media -%}
          {%- if media.media_type == 'image' -%}
            <img class="main-product" src="{{ media.preview_image | image_url: width: 1400 }}" alt="{{ media.alt | default: product.title | escape }}" width="{{ media.preview_image.width }}" height="{{ media.preview_image.height }}" {% if gallery_index == 0 %}loading="eager"{% else %}loading="lazy" hidden{% endif %} data-bhama-image="{{ gallery_index }}" data-media-id="{{ media.id }}">
            {%- assign gallery_index = gallery_index | plus: 1 -%}
          {%- endif -%}
        {%- else -%}
          <img class="main-product" src="{{ 'bhama-product-woven-vines.jpg' | asset_url }}" alt="{{ product.title | escape }}">
        {%- endfor -%}
      </div>
    </div>

    <article class="product-copy">
      <p class="eyebrow dark">{{ product.type | default: product.vendor | default: 'The Bhama Edit' }}</p>
      <h1>{{ product.title }}</h1>
      <span class="price">
        <span data-bhama-price>{{ current_variant.price | money }}</span>
        <span class="old-price{% unless current_variant.compare_at_price > current_variant.price %} is-hidden{% endunless %}" data-bhama-compare>{% if current_variant.compare_at_price > current_variant.price %}{{ current_variant.compare_at_price | money }}{% endif %}</span>
        <span class="stock-note{% unless current_variant.available %} is-sold-out{% endunless %}" data-bhama-stock>{% if current_variant.available %}In stock{% else %}Sold out{% endif %}</span>
      </span>
      {%- if product.description != blank -%}
        <p class="product-short-description">{{ product.description | strip_html | truncatewords: 34 }}</p>
      {%- else -%}
        <p class="product-short-description">{{ section.settings.fallback_description }}</p>
      {%- endif -%}

      <div class="product-trust">
        <span><i class="bi bi-patch-check"></i> Quality checked</span>
        <span><i class="bi bi-truck"></i> Secure delivery</span>
      </div>

      {% form 'product', product, data-bhama-product-form: '' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-bhama-variant-id>

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="option-row" data-bhama-option-group data-option-position="{{ option.position }}">
              <label>{{ option.name }}</label>
              <div class="sizes">
                {%- for value in option.values -%}
                  <button type="button" class="{% if option.selected_value == value %}active is-active{% endif %}" data-bhama-option-value="{{ value | escape }}" aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}">{{ value }}</button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <div class="buy-buttons">
          <div class="quantity-control quantity-control-inline">
            <label for="BhamaQuantity-{{ section.id }}">Quantity</label>
            <div class="quantity-stepper">
              <button type="button" data-bhama-qty-minus aria-label="Decrease quantity">&minus;</button>
              <input id="BhamaQuantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="Quantity" data-bhama-qty>
              <button type="button" data-bhama-qty-plus aria-label="Increase quantity">&plus;</button>
            </div>
          </div>
          <button class="btn btn-red" type="submit" name="add" data-bhama-add {% unless current_variant.available %}disabled{% endunless %}><span data-bhama-add-label>{% if current_variant.available %}Add to Cart{% else %}Sold Out{% endif %}</span></button>
          <button class="btn btn-outline" type="button" data-bhama-buy-now {% unless current_variant.available %}disabled{% endunless %}>Buy Now</button>
        </div>
        <p class="bhama-form-message" data-bhama-form-message role="status" aria-live="polite"></p>
      {% endform %}

      <div class="pick-note">
        <p class="pick-note-label">Why we picked it</p>
        <p>{{ section.settings.pick_note }}</p>
      </div>

      <div class="accordion-list">
        <details open><summary>Details</summary>{% if product.description != blank %}<div class="rte">{{ product.description }}</div>{% else %}<p>{{ section.settings.details }}</p>{% endif %}</details>
        <details><summary>Shopping Policy</summary><p>{{ section.settings.policy }}</p></details>
      </div>
    </article>
  </div>
</section>

<section class="section product-review-section">
  <div class="container-fluid">
    <div class="product-review-head">
      <div>
        <p class="eyebrow dark">Loved by you</p>
        <h2>Customer Reviews</h2>
      </div>
      <button type="button" class="review-write-link" data-bhama-write-review>Write a review</button>
    </div>
    <div id="BhamaProductReviews" class="product-review-body">
      {%- if product.metafields.reviews.rating.value != blank and product.metafields.reviews.rating_count.value != blank -%}
        {% assign rating = product.metafields.reviews.rating.value | times: 1 %}
        {% assign rating_count = product.metafields.reviews.rating_count.value | times: 1 %}
        <strong>{{ rating | round: 1 }} / 5</strong>
        <span>{{ rating_count }} review{% unless rating_count == 1 %}s{% endunless %}</span>
      {%- else -%}
        <strong>Be the first to review</strong>
        <span>Share your experience with this piece.</span>
      {%- endif -%}
    </div>
    <div id="shopify-product-reviews" data-id="{{ product.id }}">{{ product.metafields.spr.reviews }}</div>
  </div>
</section>

{%- assign related = product.collections.first.products -%}
{%- if related.size > 1 -%}
  <section class="section section-black">
    <div class="container-fluid">
      <div class="section-head">
        <div><p class="eyebrow">Styled to pair</p><h2>Complete The Look</h2></div>
        <a class="btn btn-red" href="{{ routes.all_products_collection_url }}">Shop All</a>
      </div>
      <div class="product-grid">
        {%- assign shown = 0 -%}
        {%- for item in related -%}
          {%- if item.id != product.id and shown < 4 -%}
            {% render 'bhama-product-card', product: item, quick_label: 'View Product', stock: item.type %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "BHAMA Product",
  "settings": [
    { "type": "textarea", "id": "fallback_description", "label": "Fallback description", "default": "An effortless statement piece with a traditional language and modern ease. Designed to feel Bhama, never supplier-generic." },
    { "type": "textarea", "id": "pick_note", "label": "Why we picked it", "default": "An easy statement piece that moves effortlessly from festive dinners to evening plans — traditional detail on a modern base." },
    { "type": "textarea", "id": "details", "label": "Fallback details", "default": "Fabric, fit and care details are listed with each piece. Country of origin: India." },
    { "type": "textarea", "id": "policy", "label": "Shopping policy", "default": "No returns, no exchanges, and no COD. Every product is quality checked before dispatch." }
  ]
}
{% endschema %}
