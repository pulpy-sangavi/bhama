{%- liquid
  assign c = routes.collections_url
  assign all_url = routes.all_products_collection_url
-%}

<div class="category-strip">
  <div class="container-fluid category-strip-inner">
    <a href="{{ all_url }}">New In</a>
    <a href="{{ c }}/sarees">Sarees</a>
    <a href="{{ c }}/kurtas">Kurtas</a>
    <a href="{{ c }}/dresses">Dresses</a>
    <a href="{{ c }}/co-ords">Co-ords</a>
    <a href="{{ c }}/jewellery">Jewellery</a>
    <a href="{{ routes.root_url }}#last-few">Last Few</a>
    <a href="{{ c }}/sale">Sale</a>
  </div>
</div>

<section class="page-hero">
  <div class="container-fluid">
    <p class="eyebrow">Shop</p>
    <h1>{% if collection.handle == 'all' or collection.title == blank %}New In{% else %}{{ collection.title }}{% endif %}</h1>
    {%- if collection.description != blank -%}
      <p>{{ collection.description | strip_html | truncate: 180 }}</p>
    {%- else -%}
      <p>Fresh finds, limited pieces, and a curated mix of contemporary fashion, traditional drapes, and accessories.</p>
    {%- endif -%}
  </div>
</section>

<section class="section section-ivory">
  <div class="container-fluid shop-layout">
    <aside class="filters">
      <h2>Filter</h2>
      <div class="filter-group"><strong>Shop</strong><a href="{{ all_url }}">New In</a><a href="{{ c }}/contemporary">Contemporary</a><a href="{{ c }}/traditional">Traditional</a><a href="{{ c }}/accessories">Accessories</a><a href="{{ routes.root_url }}#bhama-edit">The Bhama Edit</a><a href="{{ c }}/sale">Sale</a></div>
      <div class="filter-group"><strong>Traditional</strong><a href="{{ c }}/sarees">Sarees</a><a href="{{ c }}/kurtas">Kurtas</a><a href="{{ c }}/dupattas">Dupattas</a><a href="{{ c }}/sets">Sets</a><a href="{{ c }}/blouses">Blouses</a></div>
      <div class="filter-group"><strong>Bhama Mood</strong><a href="{{ all_url }}">Effortless</a><a href="{{ all_url }}">Statement</a><a href="{{ all_url }}">Festive</a><a href="{{ all_url }}">After Dark</a></div>
      <details class="filter-group facet-filter price-shortcuts" open>
        <summary>Price</summary>
        <div class="price-shortcut-list">
          <a href="{{ collection.url }}?filter.v.price.lte=999">Under ₹999</a>
          <a href="{{ collection.url }}?filter.v.price.gte=1000&filter.v.price.lte=1499">₹1,000 - ₹1,499</a>
          <a href="{{ collection.url }}?filter.v.price.gte=1500&filter.v.price.lte=2499">₹1,500 - ₹2,499</a>
          <a href="{{ collection.url }}?filter.v.price.gte=2500">₹2,500 &amp; above</a>
        </div>
      </details>
      <form class="collection-filters" action="{{ collection.url }}" method="get">
        {%- for filter in collection.filters -%}
          <details class="filter-group facet-filter" open>
            <summary>{{ filter.label }}</summary>
            {%- case filter.type -%}
              {%- when 'list' -%}
                {%- for value in filter.values -%}
                  <label class="facet-option">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} onchange="this.form.submit()">
                    <span>{{ value.label }}</span>
                    <small>{{ value.count }}</small>
                  </label>
                {%- endfor -%}
              {%- when 'price_range' -%}
                {%- liquid
                  assign min_value = filter.min_value.value | divided_by: 100.0
                  assign max_value = filter.max_value.value | divided_by: 100.0
                  assign range_min = filter.range_min | divided_by: 100.0
                  assign range_max = filter.range_max | divided_by: 100.0
                -%}
                <div class="price-range">
                  <label>Min <input name="{{ filter.min_value.param_name }}" type="number" min="{{ range_min | floor }}" max="{{ range_max | ceil }}" value="{{ min_value | default: range_min | floor }}" placeholder="{{ range_min | money_without_currency }}"></label>
                  <label>Max <input name="{{ filter.max_value.param_name }}" type="number" min="{{ range_min | floor }}" max="{{ range_max | ceil }}" value="{{ max_value | default: range_max | ceil }}" placeholder="{{ range_max | money_without_currency }}"></label>
                </div>
                <button type="submit">Apply price</button>
            {%- endcase -%}
          </details>
        {%- endfor -%}
        {%- if collection.filters != blank and collection.filters.size > 0 -%}
          {%- assign clear_url = collection.url -%}
          <a class="clear-filters" href="{{ clear_url }}">Clear all filters</a>
        {%- endif -%}
      </form>
    </aside>

    <div>
      {% paginate collection.products by section.settings.products_per_page %}
        <div class="shop-toolbar" id="new-in">
          <p>Showing {{ collection.products_count }} product{% unless collection.products_count == 1 %}s{% endunless %} in {{ collection.title | default: 'Just Dropped' }}</p>
          <select aria-label="Sort products" onchange="var u=new URL(window.location.href);u.searchParams.set('sort_by',this.value);window.location=u.toString();">
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            <option value="created-descending"{% if sort_by == 'created-descending' %} selected{% endif %}>Sort by: Newest</option>
            <option value="price-ascending"{% if sort_by == 'price-ascending' %} selected{% endif %}>Price: Low to High</option>
            <option value="price-descending"{% if sort_by == 'price-descending' %} selected{% endif %}>Price: High to Low</option>
          </select>
        </div>
        <div class="product-grid">
          {%- for product in collection.products -%}
            {%- liquid
              assign badge = 'New'
              assign badge_class = blank
              if product.compare_at_price > product.price
                assign badge = 'Sale'
              endif
              assign stock = product.type
              if product.available == false
                assign stock = 'Sold out'
              endif
            -%}
            {% render 'bhama-product-card', product: product, badge: badge, badge_class: badge_class, quick_label: 'View Product', stock: stock %}
          {%- else -%}
            <p class="empty-state">No products in this collection yet.</p>
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <div style="margin-top:34px;text-align:center;">{{ paginate | default_pagination }}</div>
        {%- endif -%}
      {% endpaginate %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BHAMA Collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16
    }
  ]
}
{% endschema %}
