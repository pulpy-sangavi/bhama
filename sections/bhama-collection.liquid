{%- liquid
  assign c = routes.collections_url
  assign all_url = routes.all_products_collection_url
  assign sarees_url = all_url
  assign kurtas_url = all_url
  assign dupattas_url = all_url
  assign sets_url = all_url
  assign blouses_url = all_url
  assign sale_url = all_url
  if collections.sarees != blank
    assign sarees_url = collections.sarees.url
  endif
  if collections.kurthis != blank
    assign kurtas_url = collections.kurthis.url
  endif
  if collections.duppattas != blank
    assign dupattas_url = collections.duppattas.url
  elsif collections.dupattas != blank
    assign dupattas_url = collections.dupattas.url
  endif
  if collections['suit-sets'] != blank
    assign sets_url = collections['suit-sets'].url
  endif
  if collections.blouses != blank
    assign blouses_url = collections.blouses.url
  endif
  if collections.sale != blank
    assign sale_url = collections.sale.url
  endif
-%}

<div class="category-strip">
  <div class="container-fluid category-strip-inner">
    <a href="{{ all_url }}">New In</a>
    {% if collections.sarees != blank %}<a href="{{ collections.sarees.url }}">Sarees</a>{% endif %}
    {% if collections.kurthis != blank %}<a href="{{ collections.kurthis.url }}">Kurtas</a>{% endif %}
    {% if collections.dresses != blank %}<a href="{{ collections.dresses.url }}">Dresses</a>{% endif %}
    {% if collections['co-ord-sets'] != blank %}<a href="{{ collections['co-ord-sets'].url }}">Co-ords</a>{% endif %}
    {% if collections.jewellery != blank %}<a href="{{ collections.jewellery.url }}">Jewellery</a>{% endif %}
    <a href="{{ routes.root_url }}#last-few">Last Few</a>
    <a href="{{ sale_url }}">Sale</a>
  </div>
</div>

<section class="page-hero">
  <div class="container-fluid">
    <p class="eyebrow">Shop</p>
    <h1>{% if collection.handle == 'all' or collection.title == blank %}New In{% else %}{{ collection.title }}{% endif %}</h1>
    {%- if collection.description != blank -%}
      <p>{{ collection.description | strip_html | truncate: 180 }}</p>
    {%- else -%}
      <p>Fresh finds, limited pieces, and a curated mix of contemporary fashion, traditional drapes, and accessories.</p>
    {%- endif -%}
  </div>
</section>

<section class="section section-ivory">
  <div class="container-fluid shop-layout">
    <aside class="filters" data-filter-panel>
      <div class="filters-heading">
        <h2>Filter</h2>
        <button type="button" class="filter-close" data-filter-close aria-label="Close filters">&times;</button>
      </div>
      <div class="filters-scroll">
      <div class="filter-group"><strong>Shop</strong><a href="{{ all_url }}">New In</a><a href="{{ c }}/contemporary">Contemporary</a><a href="{{ c }}/traditional">Traditional</a><a href="{{ c }}/accessories">Accessories</a><a href="{{ routes.root_url }}#bhama-edit">The Bhama Edit</a><a href="{{ c }}/sale">Sale</a></div>
      <div class="filter-group"><strong>Traditional</strong><a href="{{ sarees_url }}">Sarees</a><a href="{{ kurtas_url }}">Kurtas</a><a href="{{ dupattas_url }}">Dupattas</a><a href="{{ sets_url }}">Sets</a><a href="{{ blouses_url }}">Blouses</a></div>
      <div class="filter-group"><strong>Bhama Mood</strong><a href="{{ all_url }}">Effortless</a><a href="{{ all_url }}">Statement</a><a href="{{ all_url }}">Festive</a><a href="{{ all_url }}">After Dark</a></div>
      <form class="collection-filters" action="{{ collection.url }}" method="get">
        {%- for filter in collection.filters -%}
          {%- if filter.type == 'price_range' -%}
            {%- assign price_filter = filter -%}
          {%- else -%}
            <details class="filter-group facet-filter" open>
              <summary>{{ filter.label }}</summary>
              {%- case filter.type -%}
                {%- when 'list' -%}
                  {%- for value in filter.values -%}
                    <label class="facet-option">
                      <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} onchange="this.form.submit()">
                      <span>{{ value.label }}</span>
                      <small>{{ value.count }}</small>
                    </label>
                  {%- endfor -%}
              {%- endcase -%}
            </details>
          {%- endif -%}
        {%- endfor -%}
        {%- if price_filter -%}
          <details class="filter-group facet-filter price-filter-drawer" open>
            <summary>Price</summary>
            <div class="price-range-scale" data-price-range>
              <div class="price-range-values">
                <span>₹<output data-min-output>{{ price_filter.min_value.value | default: price_filter.range_min | divided_by: 100 | round }}</output></span>
                <span>₹<output data-max-output>{{ price_filter.max_value.value | default: price_filter.range_max | divided_by: 100 | round }}</output></span>
              </div>
              <div class="price-range-track">
                <div class="price-range-fill" data-price-fill></div>
                <input type="range" data-min-range min="{{ price_filter.range_min | divided_by: 100 | round }}" max="{{ price_filter.range_max | divided_by: 100 | round }}" value="{{ price_filter.min_value.value | default: price_filter.range_min | divided_by: 100 | round }}" step="100" aria-label="Minimum price">
                <input type="range" data-max-range min="{{ price_filter.range_min | divided_by: 100 | round }}" max="{{ price_filter.range_max | divided_by: 100 | round }}" value="{{ price_filter.max_value.value | default: price_filter.range_max | divided_by: 100 | round }}" step="100" aria-label="Maximum price">
              </div>
              <input type="hidden" name="{{ price_filter.min_value.param_name }}" data-min-input value="{{ price_filter.min_value.value | divided_by: 100 | round }}">
              <input type="hidden" name="{{ price_filter.max_value.param_name }}" data-max-input value="{{ price_filter.max_value.value | divided_by: 100 | round }}">
              <div class="price-range-ticks">
                <span>₹{{ price_filter.range_min | divided_by: 100 | round }}</span>
                <span>₹{{ price_filter.range_max | divided_by: 100 | round }}</span>
              </div>
            </div>
            <button type="submit" class="price-apply">Apply price</button>
          </details>
        {%- endif -%}
        {%- if collection.filters != blank and collection.filters.size > 0 -%}
          {%- assign clear_url = collection.url -%}
          <a class="clear-filters" href="{{ clear_url }}">Clear all filters</a>
        {%- endif -%}
      </form>
      </div>
    </aside>

    <div>
      {% paginate collection.products by section.settings.products_per_page %}
        <div class="shop-toolbar" id="new-in">
          <p>Showing {{ collection.products_count }} product{% unless collection.products_count == 1 %}s{% endunless %} in {{ collection.title | default: 'Just Dropped' }}</p>
          <div class="shop-toolbar-actions">
            <button type="button" class="filter-open" data-filter-open>Filter products</button>
            <select aria-label="Sort products" onchange="var u=new URL(window.location.href);u.searchParams.set('sort_by',this.value);window.location=u.toString();">
              {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
              <option value="created-descending"{% if sort_by == 'created-descending' %} selected{% endif %}>Sort by: Newest</option>
              <option value="price-ascending"{% if sort_by == 'price-ascending' %} selected{% endif %}>Price: Low to High</option>
              <option value="price-descending"{% if sort_by == 'price-descending' %} selected{% endif %}>Price: High to Low</option>
            </select>
          </div>
        </div>
        <div class="product-grid">
          {%- for product in collection.products -%}
            {%- liquid
              assign badge = 'New'
              assign badge_class = blank
              if product.compare_at_price > product.price
                assign badge = 'Sale'
              endif
              assign stock = product.type
              if product.available == false
                assign stock = 'Sold out'
              endif
            -%}
            {% render 'bhama-product-card', product: product, badge: badge, badge_class: badge_class, quick_label: 'View Product', stock: stock %}
          {%- else -%}
            <p class="empty-state">No products in this collection yet.</p>
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <div style="margin-top:34px;text-align:center;">{{ paginate | default_pagination }}</div>
        {%- endif -%}
      {% endpaginate %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BHAMA Collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16
    }
  ]
}
{% endschema %}
