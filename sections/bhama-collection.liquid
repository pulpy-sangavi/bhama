<section class="bhama-page-hero">
  <div class="bhama-container">
    <p class="bhama-eyebrow">Shop</p>
    <h1>{{ collection.title | default: 'All Products' }}</h1>
    {% if collection.description != blank %}
      <p>{{ collection.description | strip_html | truncate: 160 }}</p>
    {% else %}
      <p>Curated pieces for festive days, wedding moments and elegant everyday dressing.</p>
    {% endif %}
  </div>
</section>

<section class="bhama-section" style="padding-top:0;">
  <div class="bhama-container">
    {% paginate collection.products by section.settings.products_per_page %}
      <div class="bhama-grid">
        {% for product in collection.products %}
          <a class="bhama-card" href="{{ product.url }}">
            <div class="bhama-card-media">
              {% if product.compare_at_price > product.price %}
                <span class="bhama-badge">Sale</span>
              {% else %}
                <span class="bhama-badge">New</span>
              {% endif %}
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title, width: 700, height: 933 }}
              {% else %}
                <img src="{{ 'bhama-product-woven-vines.jpg' | asset_url }}" alt="{{ product.title | escape }}" width="700" height="933">
              {% endif %}
            </div>
            <div class="bhama-card-info">
              <h3>{{ product.title }}</h3>
              <span class="bhama-price">{{ product.price | money }}</span>
            </div>
          </a>
        {% else %}
          <div class="bhama-empty-state">
            <h2>No products yet</h2>
            <p>Add products to this collection in Shopify admin.</p>
          </div>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <div style="margin-top:34px;text-align:center;">
          {{ paginate | default_pagination }}
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "BHAMA Collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16
    }
  ]
}
{% endschema %}
