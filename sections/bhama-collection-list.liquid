<section class="bhama-section">
  <div class="bhama-container">
    <div class="bhama-heading">
      <div>
        <p class="bhama-eyebrow">Shop</p>
        <h2>{{ section.settings.heading | default: 'All Collections' }}</h2>
        {% if section.settings.subtext != blank %}
          <p>{{ section.settings.subtext }}</p>
        {% endif %}
      </div>
    </div>

    <div class="bhama-collection-grid bhama-collection-list-grid">
      {% for collection in collections %}
        {% unless section.settings.hide_empty and collection.products_count == 0 %}
          <a class="bhama-collection-tile" href="{{ collection.url }}">
            {% if collection.featured_image %}
              {{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: collection.title, width: 800, height: 1000 }}
            {% elsif collection.products.first.featured_image %}
              {{ collection.products.first.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: collection.title, width: 800, height: 1000 }}
            {% endif %}
            <div>
              <h3>{{ collection.title }}</h3>
              <span>{{ collection.products_count }} product{% unless collection.products_count == 1 %}s{% endunless %}</span>
            </div>
          </a>
        {% endunless %}
      {% else %}
        <p>No collections yet. Create one in Shopify admin to see it here.</p>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BHAMA Collection List",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "All Collections" },
    { "type": "textarea", "id": "subtext", "label": "Subtext" },
    { "type": "checkbox", "id": "hide_empty", "label": "Hide collections with no products", "default": true }
  ]
}
{% endschema %}
