<section class="page-hero">
  <div class="container-fluid">
    <p class="eyebrow">Shop</p>
    <h1>{{ section.settings.heading | default: 'All Collections' }}</h1>
    {% if section.settings.subtext != blank %}
      <p>{{ section.settings.subtext }}</p>
    {% endif %}
  </div>
</section>

<section class="section section-ivory">
  <div class="container-fluid">
    <div class="collection-list-toolbar" data-collection-list>
      <label class="collection-search">
        <span class="visually-hidden">Search collections</span>
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search" placeholder="Search collections" data-collection-search>
      </label>
      <div class="collection-filter-chips" aria-label="Filter collections">
        <button class="is-active" type="button" data-collection-filter="all">All</button>
        <button type="button" data-collection-filter="traditional">Traditional</button>
        <button type="button" data-collection-filter="contemporary">Contemporary</button>
        <button type="button" data-collection-filter="accessories">Accessories</button>
      </div>
      <select class="collection-sort" data-collection-sort aria-label="Sort collections">
        <option value="featured">Featured</option>
        <option value="name">Name: A-Z</option>
        <option value="products-desc">Most pieces</option>
      </select>
    </div>
    <div class="collection-grid collection-list-grid">
      {% if collections.size > 1 %}
        {% for collection in collections %}
          {% unless section.settings.hide_empty and collection.products_count == 0 %}
            <a class="collection-card tall" href="{{ collection.url }}" data-collection-card data-collection-name="{{ collection.title | escape }}" data-collection-products="{{ collection.products_count }}" data-collection-category="{{ collection.handle | escape }}">
              {% if collection.featured_image %}
                {{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: collection.title, width: 800, height: 1000 }}
              {% elsif collection.products.first.featured_image %}
                {{ collection.products.first.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: collection.title, width: 800, height: 1000 }}
              {% endif %}
              <div>
                <h3>{{ collection.title }}</h3>
                <span>{{ collection.products_count }} product{% unless collection.products_count == 1 %}s{% endunless %}</span>
              </div>
            </a>
          {% endunless %}
        {% endfor %}
      {% else %}
        {% assign fallback_titles = 'Sarees|Suit Sets|Kurthis|Co-ord Sets' | split: '|' %}
        {% assign fallback_subtitles = 'Soft silk, Jamdani and festive zari edits|Elegant occasion sets with dupatta|Comfort-first festive and everyday silhouettes|Modern separates with Indian craft details' | split: '|' %}
        {% assign fallback_images = 'bhama-product-zari.jpg|bhama-product-woven-vines.jpg|bhama-product-kurthi.jpg|bhama-collection-fusion.png' | split: '|' %}
        {% assign fallback_handles = 'sarees|suit-sets|kurthis|co-ord-sets' | split: '|' %}
        {% for title in fallback_titles %}
          <a class="collection-card tall" href="{{ routes.collections_url }}/{{ fallback_handles[forloop.index0] }}" data-collection-card data-collection-name="{{ title | escape }}" data-collection-products="{{ forloop.index }}" data-collection-category="{{ fallback_handles[forloop.index0] | escape }}">
            <img src="{{ fallback_images[forloop.index0] | asset_url }}" alt="{{ title | escape }}" width="800" height="1000" loading="lazy">
            <div>
              <h3>{{ title }}</h3>
              <span>{{ fallback_subtitles[forloop.index0] }}</span>
            </div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
    <p class="collection-empty" data-collection-empty hidden>No collections match your filters.</p>
  </div>
</section>

{% schema %}
{
  "name": "BHAMA Collection List",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "All Collections" },
    { "type": "textarea", "id": "subtext", "label": "Subtext" },
    { "type": "checkbox", "id": "hide_empty", "label": "Hide collections with no products", "default": true }
  ]
}
{% endschema %}
