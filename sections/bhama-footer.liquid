{%- liquid
  assign home_url = routes.root_url
  if routes.root_url == '/'
    assign home_url = ''
  endif
  assign instagram_url = settings.instagram_url | default: 'https://www.instagram.com/labelbhama/'
  assign whatsapp_url = settings.whatsapp_url | default: 'https://wa.me/'
  assign contemporary_url = routes.all_products_collection_url
  assign traditional_url = routes.all_products_collection_url
  assign accessories_url = routes.all_products_collection_url
  if collections.contemporary != blank and collections.contemporary.products_count > 0
    assign contemporary_url = collections.contemporary.url
  elsif collections['co-ord-sets'] != blank
    assign contemporary_url = collections['co-ord-sets'].url
  endif
  if collections.traditional != blank and collections.traditional.products_count > 0
    assign traditional_url = collections.traditional.url
  elsif collections.sarees != blank
    assign traditional_url = collections.sarees.url
  endif
  if collections.accessories != blank and collections.accessories.products_count > 0
    assign accessories_url = collections.accessories.url
  endif
-%}

<footer class="site-footer">
  <div class="container-fluid footer-main">
    <div>
      <a class="logo-link footer-logo" href="{{ routes.root_url }}">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 320 | image_tag: loading: 'lazy', alt: shop.name }}
        {%- else -%}
          <img src="{{ 'bhama-logo.png' | asset_url }}" alt="{{ shop.name }}" loading="lazy">
        {%- endif -%}
      </a>
      <p>{{ section.settings.copy }}</p>
    </div>
    <div>
      <h3>Shop</h3>
      <a href="{{ routes.all_products_collection_url }}">New In</a>
      <a href="{{ contemporary_url }}">Contemporary</a>
      <a href="{{ traditional_url }}">Traditional</a>
      <a href="{{ accessories_url }}">Accessories</a>
      <a href="{{ home_url }}/#bhama-edit">The Bhama Edit</a>
    </div>
    <div>
      <h3>Discover</h3>
      <a href="{{ home_url }}/#mood">Shop by Mood</a>
      <a href="{{ home_url }}/#occasion">Shop by Occasion</a>
      <a href="{{ home_url }}/#last-few">Last Few</a>
      <a href="{{ home_url }}/#coming-soon">Coming Soon</a>
    </div>
    <div>
      <h3>Help</h3>
      <a href="/pages/contact">About Bhama</a>
      <a href="/pages/contact">Contact Us</a>
      <a href="/policies/shipping-policy">Shipping &amp; Returns</a>
      <a href="/pages/contact#faqs">FAQs</a>
      <a href="{{ routes.account_url }}">Track Order</a>
    </div>
  </div>

  <div class="container-fluid footer-circle">
    <h3 style="color:var(--gold-soft);font-size:14px;text-transform:uppercase;">Join The Bhama Circle</h3>
    <p>New drops, private edits and restock notes — straight to your inbox.</p>
    {% form 'customer', id: 'FooterNewsletterForm', class: 'newsletter' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="email" name="contact[email]" placeholder="{% if form.posted_successfully? %}Thank you for subscribing{% else %}Enter your email{% endif %}" aria-label="Email" required>
      <button type="submit" aria-label="Subscribe"><i class="bi bi-arrow-right"></i></button>
    {% endform %}
    <div class="footer-social">
      <a href="{{ instagram_url }}" target="_blank" rel="noreferrer" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
      <a href="{{ whatsapp_url }}" target="_blank" rel="noreferrer" aria-label="WhatsApp"><i class="bi bi-whatsapp"></i></a>
    </div>
  </div>

  <div class="container-fluid footer-bottom">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | upcase }}. All rights reserved.</span>
    <span><a href="/policies/privacy-policy">Privacy</a><a href="/policies/terms-of-service">Terms</a><a href="/policies/shipping-policy">Shipping</a><a href="/policies/refund-policy">Returns</a></span>
  </div>
</footer>

{% schema %}
{
  "name": "BHAMA Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Footer copy",
      "default": "Contemporary & traditional fashion, thoughtfully curated for the modern woman."
    }
  ]
}
{% endschema %}
